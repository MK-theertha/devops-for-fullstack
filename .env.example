# Copy to .env for local development:  cp .env.example .env
# In staging/production this file is generated by the deploy workflow from
# GitHub Environment variables and secrets. Never commit a real .env.

# --- Images ---------------------------------------------------------------
# Set by CI/CD when deploying. Locally, images are built and tagged notes/*:local.
REGISTRY=notes
IMAGE_TAG=local

# --- Database -------------------------------------------------------------
POSTGRES_DB=notes
POSTGRES_USER=notes
# Use a URL-safe value elsewhere, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=local-dev-only

# --- API ------------------------------------------------------------------
LOG_LEVEL=info

# --- Edge (prod overlay only) -----------------------------------------------
DOMAIN=localhost

# --- Monitoring -------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=local-dev-only
